# Settings read by compose.yaml (see docs/install.md). Copy to .env and fill in the two passwords.
# No real secrets belong in this file; .env itself is never committed.

# Image tag of the open-kase application (pinned; bump it to upgrade).
OPEN_KASE_VERSION=0.1.1

# Which bundled TLS reverse proxy to run: nginx or caddy (one of them, not both).
# Leave empty to run your own proxy (see "Your own proxy instead" in docs/install.md).
COMPOSE_PROFILES=nginx

# Host name people use to reach the installation; it goes into the certificate
# (nginx self-signed) or is the name Caddy requests a certificate for.
SITE_NAME=support.example.com

# Host ports the proxy publishes.
HTTP_PORT=80
HTTPS_PORT=443

# Database and Redis passwords. They must equal the contents of secrets/mongo_root_password and
# secrets/redis_password. Generate each with `openssl rand -hex 32 > secrets/<file>`, then
# `sed -i "s/^MONGO_PASSWORD=.*/MONGO_PASSWORD=$(cat secrets/mongo_root_password)/" .env` (same for Redis).
MONGO_PASSWORD=
REDIS_PASSWORD=
